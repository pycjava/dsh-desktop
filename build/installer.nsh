; NSIS hooks that expose the packaged backend as the `dsh` CLI.
;
; customInstall seeds two shims into %USERPROFILE%\.dsh\bin — dsh.cmd for
; cmd.exe/PowerShell, extensionless dsh for Git Bash — then appends that dir
; to the user PATH via resources\cli\install-cli-path.ps1 (registry-safe and
; idempotent). The app rewrites the shims on every launch
; (src/ensure-cli-shim.cjs), so they track THIS install's resources\backend
; across upgrades and install-directory changes.
;
; customUnInstall deletes only the two shim files and removes the PATH entry
; (resources\cli\remove-cli-path.ps1); anything else in .dsh or .dsh\bin is
; the user's and stays. Shim templates mirror src/ensure-cli-shim.cjs.

!macro customInstall
  Push $0
  CreateDirectory "$PROFILE\.dsh\bin"

  ClearErrors
  FileOpen $0 "$PROFILE\.dsh\bin\dsh.cmd" w
  IfErrors dsh_cmd_done
  FileWrite $0 '@echo off$\r$\n'
  FileWrite $0 'rem Installed by DeepSeek Harness. Regenerated by the app on every launch.$\r$\n'
  FileWrite $0 'setlocal$\r$\n'
  FileWrite $0 'set "DSH_BACKEND=$INSTDIR\resources\backend"$\r$\n'
  FileWrite $0 'if not exist "%DSH_BACKEND%\lib\bin.js" ($\r$\n'
  FileWrite $0 '  echo [dsh] backend not found at "%DSH_BACKEND%" 1>&2$\r$\n'
  FileWrite $0 '  exit /b 1$\r$\n'
  FileWrite $0 ')$\r$\n'
  FileWrite $0 'pushd "%DSH_BACKEND%"$\r$\n'
  FileWrite $0 'node "lib\bin.js" %*$\r$\n'
  FileWrite $0 'set "DSH_RC=%ERRORLEVEL%"$\r$\n'
  FileWrite $0 'popd$\r$\n'
  FileWrite $0 'exit /b %DSH_RC%$\r$\n'
  FileClose $0
  dsh_cmd_done:

  ClearErrors
  ; $$ escapes a literal $ for bash; LF-only endings so the shebang survives.
  FileOpen $0 "$PROFILE\.dsh\bin\dsh" w
  IfErrors dsh_sh_done
  FileWrite $0 '#!/usr/bin/env bash$\n'
  FileWrite $0 '# Installed by DeepSeek Harness. Regenerated by the app on every launch.$\n'
  FileWrite $0 'DSH_BACKEND="$INSTDIR\resources\backend"$\n'
  FileWrite $0 'if [ ! -f "$$DSH_BACKEND\lib\bin.js" ]; then$\n'
  FileWrite $0 '  echo "[dsh] backend not found at $$DSH_BACKEND" >&2$\n'
  FileWrite $0 '  exit 1$\n'
  FileWrite $0 'fi$\n'
  FileWrite $0 'cd "$$DSH_BACKEND" || exit 1$\n'
  FileWrite $0 'exec node "$$DSH_BACKEND\lib\bin.js" "$$@"$\n'
  FileClose $0
  dsh_sh_done:

  nsExec::ExecToLog 'powershell -NoProfile -ExecutionPolicy Bypass -File "$INSTDIR\resources\cli\install-cli-path.ps1"'
  Pop $0
  Pop $0
!macroend

!macro customUnInstall
  Delete "$PROFILE\.dsh\bin\dsh.cmd"
  Delete "$PROFILE\.dsh\bin\dsh"
  RMDir "$PROFILE\.dsh\bin" ; no recursion: only drops when the user kept it empty
  IfFileExists "$INSTDIR\resources\cli\remove-cli-path.ps1" 0 dsh_rm_done
  nsExec::ExecToLog 'powershell -NoProfile -ExecutionPolicy Bypass -File "$INSTDIR\resources\cli\remove-cli-path.ps1"'
  Pop $0
  dsh_rm_done:
!macroend
