{
  "name": "dsh-desktop",
  "version": "0.1.1-rc.2",
  "private": true,
  "description": "Electron desktop shell for DeepSeek Harness: spawns the published dsh web backend on a loopback port and loads the Web UI in a BrowserWindow.",
  "license": "MIT",
  "author": "dsh-desktop contributors",
  "main": "src/main.cjs",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "start": "electron .",
    "backend": "node scripts/build-desktop-backend.mjs --arch x64",
    "backend:mac": "node scripts/build-desktop-backend.mjs --platform darwin --arch arm64",
    "backend:mac:x64": "node scripts/build-desktop-backend.mjs --platform darwin --arch x64",
    "dist": "node scripts/build-desktop-installer.mjs",
    "dist:mac": "node scripts/build-desktop-installer.mjs --platform darwin --arch arm64",
    "dist:mac:x64": "node scripts/build-desktop-installer.mjs --platform darwin --arch x64"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
